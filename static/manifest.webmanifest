{
  "name": "AI Selective Zoom",
  "short_name": "SelectiveZoom",
  "description": "Zoom the background of a photo while keeping subjects at original size. AI-powered selection, removal, and enhancement.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f6f9",
  "theme_color": "#0d6efd",
  "icons": [
